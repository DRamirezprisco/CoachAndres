---
const { text, align = "center", verticalPosition = "top-28" } = Astro.props;

const alignClass = {
    center: "justify-center",
    left: "justify-start",
    right: "justify-end",
};
---

<div
    class={`absolute ${verticalPosition} left-0 right-0 select-none pointer-events-none overflow-hidden flex ${
        alignClass[align]
    } opacity-[0.035] leading-none z-0`}
>
    <span
        class="font-display font-black text-[120px] sm:text-[220px] lg:text-[320px] tracking-tighter text-white uppercase whitespace-nowrap"
    >
        {text}
    </span>
</div>
