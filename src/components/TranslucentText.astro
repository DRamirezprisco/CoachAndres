---
const { text } = Astro.props;
---

<div
    class="absolute top-28 left-0 right-0 select-none pointer-events-none overflow-hidden flex justify-center opacity-[0.035] leading-none z-0"
>
    <span
        class="font-display font-black text-[120px] sm:text-[220px] lg:text-[320px] tracking-tighter text-white uppercase whitespace-nowrap"
    >
        {text}
    </span>
</div>
