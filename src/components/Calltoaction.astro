---
import { PERSONAL_DATA } from "@/constants/personalData";
import Titulo from "@/components/Titulo.astro";
---

<section
  id="video-cta"
  class="relative py-20 sm:py-28 bg-basic overflow-hidden border-t border-basic-800"
>
  <!-- Fondo con imagen calltoactionbg.webp difuminada que abarca toda la sección -->
  <div
    class="absolute inset-0 overflow-hidden pointer-events-none select-none z-0"
  >
    <img
      src="/img/calltoactionbg.webp"
      alt="Fondo de entrenamiento"
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover object-center scale-105 opacity-30"
    />
  </div>

  <!-- Resplandor verde ambiental detrás del video -->
  <div
    class="absolute top-1/2 right-1/4 -translate-y-1/2 size-150 bg-primary/10 rounded-full blur-[160px] pointer-events-none z-0"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <!-- COLUMNA IZQUIERDA: Titular, Chevron atlético y llamada a la acción -->
      <div class="lg:col-span-5 flex flex-col items-start relative">
        <!-- Chevron grande decorativo translúcido de fondo -->
        <div
          class="absolute -left-6 -top-10 select-none pointer-events-none opacity-10 -z-10"
        >
          <svg
            class="w-44 h-44 text-primary"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M8 5v14l11-7z"></path>
          </svg>
        </div>

        <!-- Tag / Eyebrow con flechas atléticas -->
        <div class="inline-flex items-center gap-2.5 mb-4">
          <div class="flex items-center text-primary">
            <svg class="w-5 h-5 -mr-2" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"
              ></path>
            </svg>
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"
              ></path>
            </svg>
          </div>
          <span
            class="text-xs sm:text-sm font-mono font-bold tracking-[0.25em] text-basic-300 uppercase"
          >
            ¡HAZLO POR TI!
          </span>
        </div>

        <!-- Título principal de gran impacto -->
        <Titulo title="TRANSFORMA" subtitle="TU VIDA" />

        <p
          class="text-basic-300 text-sm sm:text-base leading-relaxed mb-8 max-w-lg font-normal"
        >
          El cambio no empieza en el gimnasio, empieza en la decisión de no
          conformarte. Mira el video y conoce el método de entrenamiento que
          llevará tu físico al siguiente nivel.
        </p>

        <!-- Botón sutil y atlético para abrir el video desde fuera -->
        <button
          type="button"
          id="cta-open-video-btn"
          class="group/btn inline-flex items-center gap-3.5 px-6 py-3.5 bg-basic-900/90 hover:bg-primary text-white hover:text-basic-950 border border-primary/50 hover:border-primary text-xs sm:text-sm font-bold uppercase tracking-wider transition-all duration-300 shadow-xl cursor-pointer active:scale-95"
        >
          <span
            class="w-7 h-7 rounded-full bg-primary/20 group-hover/btn:bg-basic-950 text-primary group-hover/btn:text-primary flex items-center justify-center transition-colors"
          >
            <svg class="w-3.5 h-3.5 fill-current translate-x-0.5" viewBox="0 0 24 24">
              <polygon points="6 3 20 12 6 21 6 3"></polygon>
            </svg>
          </span>
          <span>Ver Video de Presentación</span>
        </button>
      </div>

      <!-- COLUMNA DERECHA: Video con encuadres atléticos idénticos a SobreMi.astro y sin redondeo -->
      <div class="lg:col-span-7 flex justify-center lg:justify-end">
        <div
          id="cta-video-trigger"
          class="relative w-full group shadow-2xl shadow-black/90 cursor-pointer select-none"
          role="button"
          tabindex="0"
          aria-label="Reproducir video de presentación"
        >
          <!-- Encuadres idénticos a SobreMi.astro con animación de pulso atlético -->
          <div
            class="absolute -top-1.25 -left-1.25 sm:-top-1.5 sm:-left-1.5 w-24 sm:w-36 h-24 sm:h-36 border-t-[5px] border-l-[5px] sm:border-t-6 sm:border-l-6 border-primary z-20 pointer-events-none animate-pulse-top"
          >
          </div>
          <div
            class="absolute -bottom-0.75 -right-0.75 sm:-bottom-1 sm:-right-1 w-14 sm:w-20 h-14 sm:h-20 border-b-[3px] border-r-[3px] sm:border-b-4 sm:border-r-4 border-primary z-20 pointer-events-none animate-pulse-bottom"
          >
          </div>

          <!-- Contenedor cuadrado de la imagen del video (sin redondeo) -->
          <div
            class="relative w-full aspect-video sm:aspect-[16/10] lg:aspect-[16/9.5] overflow-hidden bg-basic-950 border border-basic-800 group-hover:border-primary/60 transition-colors duration-500"
          >
            <!-- Imagen de portada (description.webp) -->
            <img
              src="/img/description.webp"
              alt={`Presentación de entrenamiento - ${PERSONAL_DATA.name}`}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover filter brightness-90 contrast-110 group-hover:scale-[1.03] transition-transform duration-700 ease-out"
            />

            <!-- Degradado inferior para fundir el borde de la foto idéntico a SobreMi.astro -->
            <div
              class="absolute inset-x-0 bottom-0 h-28 bg-linear-to-t from-basic via-basic/40 to-transparent pointer-events-none"
            >
            </div>

            <!-- Indicador sutil de video en la esquina inferior izquierda -->
            <div
              class="absolute bottom-4 left-4 sm:bottom-6 sm:left-6 z-20 flex items-center gap-2.5 px-3.5 py-2 bg-basic-950/85 backdrop-blur-md border border-white/10 group-hover:border-primary/60 transition-colors pointer-events-none shadow-lg"
            >
              <div
                class="size-6 rounded-full bg-primary/20 text-primary flex items-center justify-center group-hover:bg-primary group-hover:text-basic-950 transition-colors"
              >
                <svg
                  class="size-3 fill-current translate-x-0.5"
                  viewBox="0 0 24 24"
                >
                  <polygon points="6 3 20 12 6 21 6 3"></polygon>
                </svg>
              </div>
              <span
                class="text-[10px] sm:text-xs font-mono font-bold tracking-widest text-basic-200 group-hover:text-primary uppercase transition-colors"
              >
                VIDEO DE PRESENTACIÓN
              </span>
            </div>

            <!-- Icono de play central translúcido y sutil (no se roba el protagonismo ni tapa la imagen) -->
            <div
              class="absolute inset-0 flex items-center justify-center pointer-events-none"
            >
              <div
                class="size-14 sm:size-16 rounded-full bg-basic-950/45 backdrop-blur-xs border border-white/20 text-white/90 group-hover:border-primary group-hover:bg-primary/20 group-hover:text-primary group-hover:scale-110 transition-all duration-300 flex items-center justify-center shadow-xl"
              >
                <svg
                  class="w-6 h-6 sm:w-7 sm:h-7 fill-current translate-x-0.5"
                  viewBox="0 0 24 24"
                >
                  <polygon points="6 3 20 12 6 21 6 3"></polygon>
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Pantalla Completa con el Video MP4 -->
  <div
    id="cta-video-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center p-3 sm:p-6 lg:p-10 bg-black/90 backdrop-blur-2xl transition-all duration-300"
    role="dialog"
    aria-modal="true"
    aria-label="Reproductor de video"
  >
    <!-- Botón Cerrar (X) -->
    <button
      type="button"
      id="cta-close-video-modal"
      class="absolute top-4 right-4 sm:top-6 sm:right-6 z-30 w-12 h-12 rounded-full bg-basic-900/80 hover:bg-primary text-white hover:text-basic-950 border border-white/10 hover:border-primary flex items-center justify-center transition-all cursor-pointer shadow-2xl"
      aria-label="Cerrar video"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-6 h-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Contenedor del Reproductor sin redondeo -->
    <div
      class="relative w-full max-w-5xl aspect-video bg-black overflow-hidden border border-basic-700 shadow-[0_0_60px_rgba(0,0,0,0.9)] animate-in fade-in zoom-in-95 duration-200"
      id="cta-modal-video-wrapper"
    >
      <video
        id="cta-modal-video"
        controls
        playsinline
        preload="metadata"
        class="w-full h-full object-contain bg-black"
      >
        <source src="/img/video.mp4" type="video/mp4" />
        Tu navegador no soporta la reproducción de video HTML5.
      </video>
    </div>
  </div>
</section>

<style>
  @keyframes pulse-frame-top {
    0%,
    100% {
      opacity: 1;
      filter: drop-shadow(0 0 16px rgba(68, 255, 51, 0.85));
    }
    50% {
      opacity: 0.15;
      filter: drop-shadow(0 0 0px transparent);
    }
  }

  @keyframes pulse-frame-bottom {
    0%,
    100% {
      opacity: 0.15;
      filter: drop-shadow(0 0 0px transparent);
    }
    50% {
      opacity: 1;
      filter: drop-shadow(0 0 14px rgba(68, 255, 51, 0.85));
    }
  }

  .animate-pulse-top {
    animation: pulse-frame-top 2.6s ease-in-out infinite;
  }

  .animate-pulse-bottom {
    animation: pulse-frame-bottom 2.6s ease-in-out infinite;
  }
</style>

<script>
  function setupCtaVideoModal() {
    const trigger = document.getElementById("cta-video-trigger");
    const triggerBtn = document.getElementById("cta-open-video-btn");
    const modal = document.getElementById("cta-video-modal");
    const closeBtn = document.getElementById("cta-close-video-modal");
    const video = document.getElementById(
      "cta-modal-video",
    ) as HTMLVideoElement | null;

    if (!modal || !video) return;

    function openModal() {
      if (!modal || !video) return;
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.body.classList.add("overflow-hidden");
      video.play().catch(() => {
        // Maneja políticas de autoplay si aplica
      });
    }

    function closeModal() {
      if (!modal || !video) return;
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.body.classList.remove("overflow-hidden");
      video.pause();
      video.currentTime = 0;
    }

    trigger?.addEventListener("click", openModal);
    trigger?.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        openModal();
      }
    });

    triggerBtn?.addEventListener("click", openModal);
    closeBtn?.addEventListener("click", closeModal);

    // Cerrar al hacer clic en el backdrop fuera del video
    modal.addEventListener("click", (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Cerrar con Escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal.classList.contains("flex")) {
        closeModal();
      }
    });
  }

  setupCtaVideoModal();
  document.addEventListener("astro:after-swap", setupCtaVideoModal);
</script>
