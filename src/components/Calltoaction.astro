---
import { PERSONAL_DATA } from "@/constants/personalData";
import Titulo from "@/components/Titulo.astro";
---

<section
  id="video-cta"
  class="relative py-20 sm:py-28 bg-basic overflow-hidden border-t border-basic-800"
>
  <!-- Fondo con imagen calltoactionbg.webp difuminada que abarca toda la sección -->
  <div
    class="absolute inset-0 overflow-hidden pointer-events-none select-none z-0"
  >
    <img
      src="/img/calltoactionbg.webp"
      alt="Fondo de entrenamiento"
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover object-center scale-105 opacity-30"
    />
  </div>

  <!-- Resplandor verde ambiental detrás del video -->
  <div
    class="absolute top-1/2 right-1/4 -translate-y-1/2 size-150 bg-primary/10 rounded-full blur-[160px] pointer-events-none z-0"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <!-- COLUMNA IZQUIERDA: Titular, Chevron atlético y llamada a la acción -->
      <div class="lg:col-span-5 flex flex-col items-start relative">
        <!-- Chevron grande decorativo translúcido de fondo -->
        <div
          class="absolute -left-6 -top-10 select-none pointer-events-none opacity-10 -z-10"
        >
          <svg
            class="w-44 h-44 text-primary"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M8 5v14l11-7z"></path>
          </svg>
        </div>

        <!-- Tag / Eyebrow con flechas atléticas -->
        <div class="inline-flex items-center gap-2.5 mb-4">
          <div class="flex items-center text-primary">
            <svg class="w-5 h-5 -mr-2" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"
              ></path>
            </svg>
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"
              ></path>
            </svg>
          </div>
          <span
            class="text-xs sm:text-sm font-mono font-bold tracking-[0.25em] text-basic-300 uppercase"
          >
            ¡HAZLO POR TI!
          </span>
        </div>

        <!-- Título principal de gran impacto -->
        <Titulo title="TRANSFORMA" subtitle="TU VIDA" />

        <p
          class="text-basic-300 text-sm sm:text-base leading-relaxed mb-8 max-w-lg font-normal"
        >
          El cambio no empieza en el gimnasio, empieza en la decisión de no
          conformarte. Mira el video y conoce el método de entrenamiento que
          llevará tu físico al siguiente nivel.
        </p>
      </div>

      <!-- COLUMNA DERECHA: Card con imagen description.webp y Botón Play central -->
      <div class="lg:col-span-7 relative">
        <!-- Contenedor del Video Card -->
        <div
          id="cta-video-trigger"
          class="group relative w-full aspect-video sm:aspect-[16/10] lg:aspect-[16/9.5] rounded-2xl overflow-hidden border border-basic-700 hover:border-primary shadow-2xl transition-all duration-500 cursor-pointer bg-basic-950"
          role="button"
          tabindex="0"
          aria-label="Reproducir video de presentación"
        >
          <!-- Imagen de portada (description.webp) -->
          <img
            src="/img/description.webp"
            alt={`Presentación de entrenamiento - ${PERSONAL_DATA.name}`}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover filter brightness-85 contrast-110 group-hover:scale-105 group-hover:brightness-95 transition-all duration-700 ease-out"
          />

          <!-- Degradado oscuro cinematográfico -->
          <div
            class="absolute inset-0 bg-gradient-to-t from-basic-950/80 via-transparent to-black/30 group-hover:opacity-75 transition-opacity"
          >
          </div>

          <!-- Botón de Play Central con animación de pulso -->
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="relative flex items-center justify-center">
              <!-- Ondas expansivas de pulso -->
              <span
                class="absolute w-24 h-24 sm:w-28 sm:h-28 rounded-full bg-primary/20 animate-ping"
              ></span>
              <span
                class="absolute w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-primary/30"
              ></span>

              <!-- Círculo principal del botón Play -->
              <div
                class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-primary text-basic-950 flex items-center justify-center shadow-[0_0_35px_rgba(68,255,51,0.65)] group-hover:scale-110 group-hover:shadow-[0_0_50px_rgba(68,255,51,0.9)] transition-all duration-300"
              >
                <svg
                  class="w-7 h-7 sm:w-8 sm:h-8 fill-basic-950 translate-x-0.5"
                  viewBox="0 0 24 24"
                >
                  <polygon points="6 3 20 12 6 21 6 3"></polygon>
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Pantalla Completa con el Video MP4 -->
  <div
    id="cta-video-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center p-3 sm:p-6 lg:p-10 bg-black/90 backdrop-blur-2xl transition-all duration-300"
    role="dialog"
    aria-modal="true"
    aria-label="Reproductor de video"
  >
    <!-- Botón Cerrar (X) -->
    <button
      type="button"
      id="cta-close-video-modal"
      class="absolute top-4 right-4 sm:top-6 sm:right-6 z-30 w-12 h-12 rounded-full bg-basic-900/80 hover:bg-primary text-white hover:text-basic-950 border border-white/10 hover:border-primary flex items-center justify-center transition-all cursor-pointer shadow-2xl"
      aria-label="Cerrar video"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-6 h-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Contenedor del Reproductor -->
    <div
      class="relative w-full max-w-5xl aspect-video bg-black rounded-2xl overflow-hidden border border-basic-700 shadow-[0_0_60px_rgba(0,0,0,0.9)] animate-in fade-in zoom-in-95 duration-200"
      id="cta-modal-video-wrapper"
    >
      <video
        id="cta-modal-video"
        controls
        playsinline
        preload="metadata"
        class="w-full h-full object-contain bg-black"
      >
        <source src="/img/video.mp4" type="video/mp4" />
        Tu navegador no soporta la reproducción de video HTML5.
      </video>
    </div>
  </div>
</section>

<script>
  function setupCtaVideoModal() {
    const trigger = document.getElementById("cta-video-trigger");
    const triggerBtn = document.getElementById("cta-open-video-btn");
    const modal = document.getElementById("cta-video-modal");
    const closeBtn = document.getElementById("cta-close-video-modal");
    const video = document.getElementById(
      "cta-modal-video",
    ) as HTMLVideoElement | null;

    if (!modal || !video) return;

    function openModal() {
      if (!modal || !video) return;
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.body.classList.add("overflow-hidden");
      video.play().catch(() => {
        // Maneja políticas de autoplay si aplica
      });
    }

    function closeModal() {
      if (!modal || !video) return;
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.body.classList.remove("overflow-hidden");
      video.pause();
      video.currentTime = 0;
    }

    trigger?.addEventListener("click", openModal);
    trigger?.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        openModal();
      }
    });

    triggerBtn?.addEventListener("click", openModal);
    closeBtn?.addEventListener("click", closeModal);

    // Cerrar al hacer clic en el backdrop fuera del video
    modal.addEventListener("click", (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Cerrar con Escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal.classList.contains("flex")) {
        closeModal();
      }
    });
  }

  setupCtaVideoModal();
  document.addEventListener("astro:after-swap", setupCtaVideoModal);
</script>
