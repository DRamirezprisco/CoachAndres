---
interface Props {
  title: string;
  subtitle: string;
  class?: string;
  titleClass?: string;
  subtitleClass?: string;
}

const {
  title,
  subtitle,
  class: className = "",
  titleClass = "",
  subtitleClass = "",
} = Astro.props;
---

<h2
  class={`font-sans font-black tracking-tight text-basic-50 uppercase ${className || "text-lg sm:text-5xl xl:text-6xl mb-6"}`}
>
  <span class={titleClass}>{title}</span>
  <br />
  <span
    class={`text-primary text-glow-lime font-serif ${subtitleClass || (className ? "" : "text-lg sm:text-5xl xl:text-6xl")}`}
    >{subtitle}</span
  >
</h2>
