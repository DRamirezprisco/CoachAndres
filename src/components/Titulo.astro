---
const { title, subtitle } = Astro.props;
---

<h2
  class="font-sans font-black text-lg sm:text-5xl xl:text-6xl tracking-tight text-basic-50 uppercase mb-6"
>
  {title}
  <br />
  <span
    class="text-primary text-lg sm:text-5xl xl:text-6xl text-glow-lime font-serif"
    >{subtitle}</span
  >
</h2>
