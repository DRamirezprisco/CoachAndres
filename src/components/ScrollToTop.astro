---
import { PERSONAL_DATA } from "@/constants/personalData";
import { SITE_CONFIG } from "@/constants/site";

// Obtener el número definido para el sitio
const baseNumber =
  SITE_CONFIG.whatsappUrl?.split("wa.me/")[1]?.split("?")[0] ||
  SITE_CONFIG.phone ||
  "573158361031";
const cleanNumber = baseNumber.replace(/[^0-9]/g, "");
const fullPhone = cleanNumber.startsWith("57") ? cleanNumber : `57${cleanNumber}`;

// Mensaje predeterminado de contacto
const defaultMessage = `¡Hola ${PERSONAL_DATA.name}! Me gustaría comunicarme contigo para solicitar información sobre tus entrenamientos y planes personalizados.`;
const whatsappHref = `https://wa.me/${fullPhone}?text=${encodeURIComponent(defaultMessage)}`;
---

<div class="fixed right-5 sm:right-6 bottom-5 sm:bottom-6 z-50 flex items-center gap-2.5 sm:gap-3">
  <!-- Botón Flotante de WhatsApp (A la izquierda) -->
  <a
    href={whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Contactar a ${PERSONAL_DATA.name} por WhatsApp`}
    class="relative group flex h-13 w-13 sm:h-14 sm:w-14 items-center justify-center rounded-full bg-basic-950/90 text-primary border border-primary/40 backdrop-blur-md shadow-2xl shadow-black/80 transition-all duration-300 hover:bg-primary hover:text-basic-950 hover:border-primary hover:scale-110 hover:shadow-[0_0_25px_rgba(68,255,51,0.5)] active:scale-95 cursor-pointer"
  >
    <!-- Tooltip descriptivo en hover para desktop -->
    <span
      class="absolute right-full mr-3 px-3 py-1.5 rounded-lg bg-basic-900/95 border border-primary/30 text-white text-xs font-medium whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-all duration-200 shadow-xl hidden sm:flex items-center gap-1.5 backdrop-blur-md"
    >
      <span class="size-1.5 rounded-full bg-primary animate-pulse"></span>
      ¿Hablamos por WhatsApp?
    </span>

    <!-- Icono oficial de WhatsApp -->
    <svg
      class="size-6 sm:size-6.5 fill-current transition-transform duration-300 group-hover:scale-110"
      viewBox="0 0 24 24"
    >
      <path
        d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
      ></path>
    </svg>
  </a>

  <!-- Botón Flotante Volver Arriba (A la derecha) -->
  <button
    id="scroll-to-top"
    class="relative flex h-13 w-13 sm:h-14 sm:w-14 items-center justify-center rounded-full bg-basic-950/90 text-primary border border-primary/30 backdrop-blur-md shadow-2xl shadow-black/80 transition-all duration-300 translate-y-20 opacity-0 pointer-events-none cursor-pointer group hover:border-primary hover:scale-110 hover:shadow-[0_0_25px_rgba(68,255,51,0.4)] active:scale-95"
    aria-label="Volver arriba"
  >
    <!-- SVG circular de progreso -->
    <svg
      class="absolute top-0 left-0 h-full w-full -rotate-90 pointer-events-none"
      viewBox="0 0 36 36"
    >
      <!-- Círculo de guía / fondo -->
      <circle
        cx="18"
        cy="18"
        r="16"
        fill="none"
        class="stroke-white/10"
        stroke-width="2.5"></circle>

      <!-- Círculo de avance con color primary (#44FF33) -->
      <circle
        id="progress-circle"
        cx="18"
        cy="18"
        r="16"
        fill="none"
        class="stroke-primary transition-[stroke-dashoffset] duration-150 ease-out"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-dasharray="100.53"
        stroke-dashoffset="100.53"></circle>
    </svg>

    <!-- Icono de flecha hacia arriba -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="2.5"
      stroke="currentColor"
      class="relative z-10 size-5 sm:size-6 text-primary group-hover:text-white transition-colors duration-300"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18"></path>
    </svg>
  </button>
</div>

<script>
  function setupScrollToTop() {
    const button = document.getElementById("scroll-to-top");
    const progressCircle = document.getElementById(
      "progress-circle",
    ) as SVGCircleElement | null;

    if (!button || !progressCircle) return;

    // Radio r = 16 => Circunferencia = 2 * PI * 16 ≈ 100.53
    const circumference = 100.53;

    const updateScroll = () => {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight =
        document.documentElement.scrollHeight - window.innerHeight;

      if (docHeight <= 0) return;

      const scrollPercent = Math.min(Math.max(scrollTop / docHeight, 0), 1);
      const offset = circumference - scrollPercent * circumference;
      progressCircle.style.strokeDashoffset = offset.toString();

      // Mostrar u ocultar el botón si bajamos más de 100px
      if (scrollTop > 100) {
        button.classList.remove("translate-y-20", "opacity-0", "pointer-events-none");
        button.classList.add("translate-y-0", "opacity-100", "pointer-events-auto");
      } else {
        button.classList.remove("translate-y-0", "opacity-100", "pointer-events-auto");
        button.classList.add("translate-y-20", "opacity-0", "pointer-events-none");
      }
    };

    button.addEventListener("click", () => {
      window.scrollTo({
        top: 0,
        behavior: "smooth",
      });
    });

    window.addEventListener("scroll", updateScroll, { passive: true });
    window.addEventListener("resize", updateScroll, { passive: true });

    updateScroll();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupScrollToTop);
  } else {
    setupScrollToTop();
  }
  document.addEventListener("astro:page-load", setupScrollToTop);
</script>
