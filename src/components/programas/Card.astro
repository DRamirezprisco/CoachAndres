---
const { prog } = Astro.props;
---

<div
  class="relative program-card bg-basic-900/90 rounded-xl border border-basic-800 hover:border-primary transition-all duration-300 flex flex-col justify-between group overflow-hidden shadow-2xl"
  data-category={prog.category}
>
  <div>
    <!-- Cabecera con Imagen y Superposición con Degradado -->
    <div class="relative h-full w-full overflow-hidden bg-basic-950">
      <img
        src={prog.image}
        alt={prog.title}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover filter brightness-90 contrast-110 group-hover:scale-105 transition-transform duration-700 ease-out"
      />
      <div
        class="absolute inset-0 bg-linear-to-t from-basic-900 via-basic-900/40 to-transparent"
      >
      </div>
    </div>

    <!-- Contenido de la Tarjeta -->
    <div class="absolute bottom-15 w-full p-6 sm:px-7">
      <h3
        class="font-sans text-xl sm:text-2xl font-bold uppercase text-white tracking-wide group-hover:text-primary transition-colors mb-5"
      >
        {prog.title}
      </h3>

      <!-- Barra de Métricas Técnicas -->
      <div
        class="grid grid-cols-3 gap-2 py-3 px-4 bg-basic-950 border border-basic-800 rounded-xs mb-6 text-center"
      >
        <div>
          <span
            class="block text-[9px] uppercase font-bold text-basic-400 tracking-wider"
          >
            Nivel
          </span>
          <span class="block text-xs font-semibold text-white mt-0.5">
            {prog.level}
          </span>
        </div>
        <div class="border-x border-basic-800">
          <span
            class="block text-[9px] uppercase font-bold text-basic-400 tracking-wider"
          >
            Duración
          </span>
          <span class="block text-xs font-semibold text-white mt-0.5">
            {prog.duration}
          </span>
        </div>
        <div>
          <span
            class="block text-[9px] uppercase font-bold text-basic-400 tracking-wider"
          >
            Frecuencia
          </span>
          <span class="block text-xs font-semibold text-primary mt-0.5">
            {prog.frequency}
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer y Llamada a la Acción de la Tarjeta -->
  <div
    class="px-6 sm:px-7 pb-6 sm:pb-7 pt-4 border-t border-basic-800 flex items-center justify-between"
  >
    <div class="flex items-baseline gap-1">
      <span class="text-xs font-mono font-bold text-zinc-400">$</span><span
        class="price-display font-display text-5xl font-bold text-white tracking-tight"
        >{prog.precio}</span
      ><span class="text-xs font-mono text-zinc-400 uppercase tracking-wider"
        >.000 / Mes</span
      >
    </div>

    <button
      class="flex items-center justify-center gap-2 cursor-pointer hover:text-primary transition-colors"
    >
      Más información <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
          d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path></svg
      >
    </button>
  </div>
</div>
