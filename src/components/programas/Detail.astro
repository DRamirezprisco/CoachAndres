---
import type { ProgramItem } from "@/constants/programs";
import ButtonAlt from "@/components/ButtonAlt.astro";

interface Props {
  prog: ProgramItem;
}

const { prog } = Astro.props;
---

<!-- Modal Backdrop y Contenedor -->
<div
  id={`modal-${prog.id}`}
  class="program-modal fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6 bg-black/80 backdrop-blur-md transition-all duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby={`modal-title-${prog.id}`}
>
  <!-- Tarjeta Modal -->
  <div
    class="modal-content relative w-full max-w-2xl bg-basic-900 border border-basic-700 rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[92vh] my-auto animate-in fade-in zoom-in-95 duration-200"
  >
    <!-- Botón Cerrar (X) -->
    <button
      type="button"
      data-close-modal
      class="absolute top-4 right-4 z-30 w-10 h-10 rounded-full bg-basic-950/80 hover:bg-basic-800 text-white/80 hover:text-white border border-white/10 flex items-center justify-center transition-all cursor-pointer shadow-lg"
      aria-label="Cerrar modal"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-5 h-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Cuerpo con Scroll Interno -->
    <div class="overflow-y-auto">
      <!-- Cabecera con Imagen y Superposición con Degradado -->
      <div
        class="relative h-60 sm:h-72 w-full overflow-hidden bg-basic-950 shrink-0"
      >
        <img
          src={prog.image}
          alt={prog.title}
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover filter brightness-90 contrast-110"
        />
        <div
          class="absolute inset-0 bg-linear-to-t from-basic-900 via-basic-900/40 to-transparent"
        >
        </div>

        <!-- Barra de Medidor de Intensidad -->
        <div
          class="absolute bottom-3 left-4 right-4 flex items-center justify-between text-[10px] uppercase bg-basic-950/90 backdrop-blur-md p-2 rounded-xs border border-basic-800"
        >
          <span class="text-basic-400 font-bold">
            INTENSIDAD DE EXIGENCIA:
          </span>
          <div class="flex items-center gap-1">
            {
              [1, 2, 3, 4, 5].map((bar) => (
                <div
                  class={`w-3 h-2 rounded-xs transition-colors ${
                    bar <= prog.intensityBars
                      ? "bg-primary shadow-[0_0_8px_rgba(68,255,51,0.6)]"
                      : "bg-basic-800"
                  }`}
                />
              ))
            }
            <span class="text-white font-bold ml-1.5">
              {prog.intensity}
            </span>
          </div>
        </div>
      </div>

      <!-- Contenido Detallado -->
      <div class="p-6 sm:p-8">
        <div class="flex items-baseline justify-between gap-4 mb-3 flex-wrap">
          <h3
            id={`modal-title-${prog.id}`}
            class="font-sans text-2xl sm:text-3xl font-bold uppercase text-white tracking-wide"
          >
            {prog.title}
          </h3>
        </div>

        <p
          class="text-xs sm:text-sm text-basic-300 leading-relaxed mb-6 font-normal"
        >
          {prog.description}
        </p>

        <!-- Barra de Métricas Técnicas -->
        <div
          class="grid grid-cols-3 gap-2 py-3 px-4 bg-basic-950 border border-basic-800 rounded-xs mb-6 text-center"
        >
          <div>
            <span
              class="block text-[9px] uppercase font-bold text-basic-400 tracking-wider"
            >
              Nivel
            </span>
            <span class="block text-xs font-semibold text-white mt-0.5">
              {prog.level}
            </span>
          </div>
          <div class="border-x border-basic-800">
            <span
              class="block text-[9px] uppercase font-bold text-basic-400 tracking-wider"
            >
              Duración
            </span>
            <span class="block text-xs font-semibold text-white mt-0.5">
              {prog.duration}
            </span>
          </div>
          <div>
            <span
              class="block text-[9px] uppercase font-bold text-basic-400 tracking-wider"
            >
              Frecuencia
            </span>
            <span class="block text-xs font-semibold text-primary mt-0.5">
              {prog.frequency}
            </span>
          </div>
        </div>

        <!-- Lista de Especificaciones Técnicas -->
        {
          prog.highlights && prog.highlights.length > 0 && (
            <div class="space-y-2 mb-2">
              <span class="block text-[11px] uppercase font-bold tracking-wider text-white">
                ESPECIFICACIONES TÉCNICAS:
              </span>
              {prog.highlights.map((item) => (
                <div class="flex items-start gap-2.5 text-xs sm:text-sm text-basic-300">
                  <span class="text-primary font-black leading-none pt-0.5">
                    &gt;
                  </span>
                  <span class="leading-snug">{item}</span>
                </div>
              ))}
            </div>
          )
        }
      </div>

      <!-- Footer y Llamada a la Acción de la Tarjeta -->
      <div
        class="px-6 sm:px-8 pb-6 sm:pb-8 pt-4 border-t border-basic-800 flex items-center justify-between bg-basic-950/60"
      >
        {
          prog.precio && (
            <div class="flex items-baseline gap-1">
              <span class="text-xs font-mono font-bold text-zinc-400">$</span>
              <span class="font-sans text-3xl font-bold text-white tracking-tight">
                {prog.precio}
              </span>
              <span class="text-xs font-mono text-zinc-400 uppercase tracking-wider">
                .000 / Mes
              </span>
            </div>
          )
        }

        <ButtonAlt href="#contactame" text="elegir plan" />
      </div>
    </div>
  </div>
</div>
