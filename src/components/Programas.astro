---
import { PROGRAMS_DATA } from "@/constants/programs";
import Titulo from "@/components/Titulo.astro";
import ButtonAlt from "@/components/ButtonAlt.astro";
---

<section
  id="programas"
  class="py-24 bg-basic border-t border-basic-800 relative bg-dots-pattern overflow-hidden"
>
  <!-- Resplandor ambiental de fondo sutil -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 size-150 bg-primary/5 rounded-full blur-[160px] pointer-events-none"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Encabezado de la Sección -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between mb-14">
      <div class="max-w-xl">
        <div
            class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-basic/80 border border-primary/20 backdrop-blur-md mb-6"
        >
            <span
            class="h-2 w-2 rounded-full bg-primary animate-pulse shadow-[0_0_10px_#44FF33]"
            ></span>
            <span
            class="text-xs sm:text-sm font-semibold tracking-wider uppercase text-basic-50"
            >
            ESPECIALIZACIONES DE ENTRENAMIENTO
            </span>
        </div>
        
        <Titulo 
          title="PROGRAMAS DE"
          subtitle="ALTO RENDIMIENTO"
        />
        <p class="text-basic-300 text-xs sm:text-sm mt-3 font-normal leading-relaxed">
          Selecciona el protocolo científicamente diseñado para tu objetivo físico actual.
        </p>
      </div>

      <!-- Controles de Filtro -->
      <div class="mt-6 lg:mt-0 flex flex-wrap gap-2" id="program-filters">
        <button
          data-filter="all"
          class="filter-btn active-filter px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-xs transition-all duration-200 bg-primary text-basic-950 border border-primary shadow-sm cursor-pointer"
        >
          [ TODOS LOS PROGRAMAS ]
        </button>
        {
          PROGRAMS_DATA.map((prog) => (
            <button
              data-filter={prog.category}
              class="filter-btn px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-xs transition-all duration-200 bg-basic-900 text-basic-300 hover:text-primary cursor-pointer"
            >
              {prog.menu ? prog.menu.toUpperCase() : prog.category.toUpperCase()}
            </button>
          ))
        }
      </div>
    </div>

    <!-- Grid de Programas (Tarjetas con Imágenes Fotográficas) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="programs-grid">
      {
        PROGRAMS_DATA.map((prog, index) => (
          <div
            class="program-card bg-basic-900/90 border border-basic-800 hover:border-primary transition-all duration-300 flex flex-col justify-between group overflow-hidden shadow-2xl rounded-xs"
            data-category={prog.category}
          >
            <div>
              <!-- Cabecera con Imagen y Superposición con Degradado -->
              <div class="relative h-60 sm:h-64 w-full overflow-hidden bg-basic-950">
                <img
                  src={prog.image}
                  alt={prog.title}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover filter brightness-90 contrast-110 group-hover:scale-105 transition-transform duration-700 ease-out"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-basic-900 via-basic-900/40 to-transparent" />

                <!-- Badges Superiores sobre la Imagen -->
                <div class="absolute top-4 left-4 right-4 flex items-center justify-between">
                  <span
                    class={`text-[10px] font-mono font-black uppercase tracking-widest px-2.5 py-1 rounded-xs shadow-md ${prog.badgeColor}`}
                  >
                    {prog.tag}
                  </span>
                  <span class="text-xs font-mono font-bold text-white bg-basic-950/80 backdrop-blur-sm px-2.5 py-0.5 rounded-xs border border-basic-700">
                    0{index + 1} | PROTOCOLO
                  </span>
                </div>

                <!-- Barra de Medidor de Intensidad -->
                <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between text-[10px] uppercase bg-basic-950/90 backdrop-blur-md p-2 rounded-xs border border-basic-800">
                  <span class="text-basic-400 font-bold">
                    INTENSIDAD DE EXIGENCIA:
                  </span>
                  <div class="flex items-center gap-1">
                    {[1, 2, 3, 4, 5].map((bar) => (
                      <div
                        class={`w-3 h-2 rounded-xs transition-colors ${
                          bar <= prog.intensityBars
                            ? "bg-primary shadow-[0_0_8px_rgba(68,255,51,0.6)]"
                            : "bg-basic-800"
                        }`}
                      />
                    ))}
                    <span class="text-white font-bold ml-1.5">
                      {prog.intensity}
                    </span>
                  </div>
                </div>
              </div>

              <!-- Contenido de la Tarjeta -->
              <div class="p-6 sm:p-7">
                <h3 class="font-sans text-2xl sm:text-3xl font-bold uppercase text-white tracking-wide group-hover:text-primary transition-colors mb-2">
                  {prog.title}
                </h3>
                <p class="text-xs sm:text-sm text-basic-300 leading-relaxed mb-6 font-normal">
                  {prog.description}
                </p>

                <!-- Barra de Métricas Técnicas -->
                <div class="grid grid-cols-3 gap-2 py-3 px-4 bg-basic-950 border border-basic-800 rounded-xs mb-6 text-center">
                  <div>
                    <span class="block text-[9px] uppercase font-bold text-basic-400 tracking-wider">
                      Nivel
                    </span>
                    <span class="block text-xs font-semibold text-white mt-0.5">
                      {prog.level}
                    </span>
                  </div>
                  <div class="border-x border-basic-800">
                    <span class="block text-[9px] uppercase font-bold text-basic-400 tracking-wider">
                      Duración
                    </span>
                    <span class="block text-xs font-semibold text-white mt-0.5">
                      {prog.duration}
                    </span>
                  </div>
                  <div>
                    <span class="block text-[9px] uppercase font-bold text-basic-400 tracking-wider">
                      Frecuencia
                    </span>
                    <span class="block text-xs font-semibold text-primary mt-0.5">
                      {prog.frequency}
                    </span>
                  </div>
                </div>

                <!-- Lista de Especificaciones Técnicas -->
                <div class="space-y-2 mb-2">
                  <span class="block text-[11px] uppercase font-bold tracking-wider text-white">
                    ESPECIFICACIONES TÉCNICAS:
                  </span>
                  {prog.highlights.map((item) => (
                    <div class="flex items-start gap-2.5 text-sm text-basic-300">
                      <span class="text-primary font-black leading-none pt-0.5">
                        &gt;
                      </span>
                      <span class="leading-snug">{item}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <!-- Footer y Llamada a la Acción de la Tarjeta -->
            <div class="px-6 sm:px-7 pb-6 sm:pb-7 pt-4 border-t border-basic-800 flex items-center justify-between">
              <span class="text-sm text-basic-300 font-semibold">
                Plazas abiertas este mes
              </span>

              <ButtonAlt href="#contactame" text="POSTULAR AL PROGRAMA" />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  function setupProgramFilters() {
    const filterButtons = document.querySelectorAll(".filter-btn");
    const cards = document.querySelectorAll(".program-card");

    if (!filterButtons.length || !cards.length) return;

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.getAttribute("data-filter");

        // Restablecer estilos de botones inactivos
        filterButtons.forEach((b) => {
          b.classList.remove(
            "active-filter",
            "bg-primary",
            "text-basic-950",
            "border-primary",
            "shadow-sm"
          );
          b.classList.add(
            "bg-basic-900",
            "text-basic-300",
            "border-basic-800"
          );
        });

        // Activar botón seleccionado
        btn.classList.add(
          "active-filter",
          "bg-primary",
          "text-basic-950",
          "border-primary",
          "shadow-sm"
        );
        btn.classList.remove(
          "bg-basic-900",
          "text-basic-300",
          "border-basic-800"
        );

        // Filtrar tarjetas
        cards.forEach((card) => {
          const cat = card.getAttribute("data-category");
          const htmlCard = card as HTMLElement;
          if (filter === "all" || cat === filter) {
            htmlCard.style.display = "flex";
          } else {
            htmlCard.style.display = "none";
          }
        });
      });
    });
  }

  setupProgramFilters();
  document.addEventListener("astro:after-swap", setupProgramFilters);
</script>
