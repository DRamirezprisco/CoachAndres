---
import AmbientGlow from "@/components/AmbientGlow.astro";
import { PERSONAL_DATA } from "@/constants/personalData";
import SOCIAL from "@/constants/social";

// Redes sociales filtradas
const instagramUrl = SOCIAL.find((s) => s.name === "Instagram")?.url || "#";
const whatsappUrl = PERSONAL_DATA.whatsappUrl;
const youtubeUrl = SOCIAL.find((s) => s.name === "Youtube")?.url || "#";
const tiktokUrl = SOCIAL.find((s) => s.name === "TikTok")?.url || "#";
---

<section id="sobre-mi" class="relative overflow-hidden max-w-full [contain:paint] bg-basic py-20 lg:py-28">
    <!-- Fondo y efectos de iluminación -->
    <AmbientGlow />

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <div
            class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center w-full"
        >
            <!-- COLUMNA IZQUIERDA: Fotografía atlética de Andrés (andres2.webp) -->
            <div class="lg:col-span-5 flex justify-center lg:justify-start w-full min-w-0">
                <div
                    class="relative w-full max-w-full sm:max-w-110 group shadow-2xl shadow-black/90"
                >
                    <!-- Encuadres -->
                    <div
                        class="absolute -top-1.25 -left-1.25 sm:-top-1.5 sm:-left-1.5 w-28 sm:w-36 h-28 sm:h-36 border-t-[6px] border-l-[6px] sm:border-t-6 sm:border-l-6 border-primary z-20 pointer-events-none animate-pulse-top"
                    >
                    </div>
                    <div
                        class="absolute -bottom-0.75 -right-0.75 sm:-bottom-1 sm:-right-1 w-14 sm:w-20 h-14 sm:h-20 border-b-[3px] border-r-[3px] sm:border-b-4 sm:border-r-4 border-primary z-20 pointer-events-none animate-pulse-bottom"
                    >
                    </div>

                    <!-- Contenedor cuadrado de la imagen  -->
                    <div class="relative w-full overflow-hidden">
                        <img
                            src="/img/andres2.webp"
                            alt={PERSONAL_DATA.name}
                            loading="lazy"
                            decoding="async"
                            class="w-full h-130 sm:h-150 lg:h-162.5 object-cover object-top transition-transform duration-700 group-hover:scale-[1.03]"
                        />
                        <!-- Degradado inferior para fundir el borde de la foto -->
                        <div
                            class="absolute inset-x-0 bottom-0 h-28 bg-linear-to-t from-basic via-basic/40 to-transparent pointer-events-none"
                        >
                        </div>
                    </div>
                </div>
            </div>

            <!-- COLUMNA DERECHA: Biografía, métricas y videos -->
            <div class="lg:col-span-7 flex flex-col justify-center w-full min-w-0">
                <h2
                    class="font-black text-4xl sm:text-5xl lg:text-6xl text-primary uppercase tracking-tight my-2"
                >
                    SOBRE MÍ
                </h2>

                <!-- Barra de métricas con líneas divisorias -->
                <div
                    class="grid grid-cols-3 gap-2 sm:gap-4 md:gap-6 py-5 border-y border-white/10 my-6 max-w-xl w-full text-center"
                >
                    <div class="flex flex-col items-center justify-center text-center">
                        <span
                            class="block text-[10px] sm:text-xs text-white/50 uppercase tracking-wider font-semibold mb-1"
                        >
                            EDAD
                        </span>
                        <span
                            class="text-xl sm:text-2xl lg:text-3xl font-sans font-black text-white whitespace-nowrap"
                        >
                            28 años
                        </span>
                    </div>

                    <div class="flex flex-col items-center justify-center text-center">
                        <span
                            class="block text-[10px] sm:text-xs text-white/50 uppercase tracking-wider font-semibold mb-1"
                        >
                            AÑOS DE EXP.
                        </span>
                        <span
                            class="text-xl sm:text-2xl lg:text-3xl font-sans font-black text-basic-50 whitespace-nowrap"
                        >
                            + {PERSONAL_DATA.experienceYear}
                        </span>
                    </div>

                    <div class="flex flex-col items-center justify-center text-center">
                        <span
                            class="block text-[10px] sm:text-xs text-white/50 uppercase tracking-wider font-semibold mb-1"
                        >
                            CLIENTES
                        </span>
                        <span
                            class="text-xl sm:text-2xl lg:text-3xl font-sans font-black text-white whitespace-nowrap"
                        >
                            {PERSONAL_DATA.clientes}
                        </span>
                    </div>
                </div>

                <!-- Nombre del Coach y Redes Sociales -->
                <div
                    class="flex items-center justify-between flex-wrap gap-4 mb-4"
                >
                    <div class="flex items-center gap-2">
                        <div class="flex items-start justify-start">
                            <img
                                src="/img/logo.webp"
                                alt="Logo"
                                class="size-10"
                            />
                        </div>

                        <div class="flex flex-col leading-tight select-none">
                            <span
                                class="text-lg sm:text-xl font-bold tracking-wider text-white uppercase font-serif"
                            >
                                {PERSONAL_DATA.name}
                            </span>
                            <span
                                class="text-[9px] sm:text-[11px] font-semibold tracking-[0.26em] text-white/60 uppercase"
                            >
                                Entrenador Personal
                            </span>
                        </div>
                    </div>

                    <!-- Iconos de Redes Sociales -->
                    <div class="flex items-center gap-0.5">
                        <!-- Instagram -->
                        <a
                            href={instagramUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Instagram de Andrés Sastoque"
                            class="w-10 h-10 flex items-center justify-center text-white/70 hover:text-primary hover:border-primary/50 hover:bg-primary/10 hover:transition-all hover:rounded-full hover:border"
                        >
                            <svg
                                class="size-5.5"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                viewBox="0 0 24 24"
                            >
                                <rect
                                    width="20"
                                    height="20"
                                    x="2"
                                    y="2"
                                    rx="5"
                                    ry="5"></rect>
                                <path
                                    d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                                ></path>
                                <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"
                                ></line>
                            </svg>
                        </a>
                        <!-- WhatsApp -->
                        <a
                            href={whatsappUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="WhatsApp de Andrés Sastoque"
                            class="w-10 h-10 flex items-center justify-center text-white/70 hover:text-primary hover:border-primary/50 hover:bg-primary/10 hover:transition-all hover:rounded-full hover:border"
                        >
                            <svg
                                class="size-5.5"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
                                ></path>
                            </svg>
                        </a>
                        <!-- TikTok -->
                        <a
                            href={tiktokUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="TikTok de Andrés Sastoque"
                            class="w-10 h-10 flex items-center justify-center text-white/70 hover:text-primary hover:border-primary/50 hover:bg-primary/10 hover:transition-all hover:rounded-full hover:border"
                        >
                            <svg
                                class="size-4.5"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.97v7.65c0 2.05-.6 4.12-1.87 5.76-1.42 1.83-3.6 2.98-5.91 3.08-2.6.12-5.22-.88-6.91-2.83-1.84-2.11-2.45-5.08-1.6-7.79.81-2.58 2.92-4.63 5.5-5.28.32-.08.64-.13.97-.17v4.11c-.55.13-1.09.35-1.55.71-.85.67-1.32 1.75-1.25 2.82.07 1.14.73 2.18 1.72 2.67 1 .5 2.21.43 3.14-.17.72-.47 1.18-1.28 1.25-2.14.03-.52.02-1.04.02-1.56V.02h.65z"
                                ></path>
                            </svg>
                        </a>
                        <!-- YouTube -->
                        <a
                            href={youtubeUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="YouTube de Andrés Sastoque"
                            class="w-10 h-10 flex items-center justify-center text-white/70 hover:text-primary hover:border-primary/50 hover:bg-primary/10 hover:transition-all hover:rounded-full hover:border"
                        >
                            <svg
                                class="size-5"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
                                ></path>
                            </svg>
                        </a>
                    </div>
                </div>

                <p
                    class="text-sm sm:text-base text-basic-50 leading-relaxed mb-3"
                >
                    {PERSONAL_DATA.description}
                </p>
                <p
                    class="mx-auto text-base sm:text-lg text-basic-300 max-w-xl font-light italic leading-relaxed mb-6 mt-2 text-center"
                >
                    {PERSONAL_DATA.slogan}
                </p>

                <!-- Sección de Contenido Multimedia -->
                <div class="mt-2">
                    <!-- Grid de 3 miniaturas de entrenamiento -->
                    <div class="grid grid-cols-3 gap-3 sm:gap-4">
                        <!-- Miniatura 1 -->
                        <div
                            class="group relative aspect-4/3 rounded-lg overflow-hidden border border-primary/40 transition-all cursor-pointer shadow-xl bg-basic-900"
                        >
                            <img
                                src="/img/foto2.webp"
                                alt="Entrenamiento Andrés Sastoque"
                                loading="lazy"
                                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                            />
                            <div
                                class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-colors flex items-center justify-center"
                            >
                                <span
                                    class="block text-[11px] sm:text-xs text-basic-50 uppercase tracking-widest font-bold mb-1"
                                >
                                    FUERZA
                                </span>
                            </div>
                        </div>

                        <!-- Miniatura 2 -->
                        <div
                            class="group relative aspect-4/3 rounded-lg overflow-hidden border border-primary/40 transition-all cursor-pointer shadow-xl bg-basic-900"
                        >
                            <img
                                src="/img/foto5.webp"
                                alt="Rutina de ejercicio"
                                loading="lazy"
                                class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-110"
                            />
                            <div
                                class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-colors flex items-center justify-center"
                            >
                                <span
                                    class="block text-[11px] sm:text-xs text-basic-50 uppercase tracking-widest font-bold mb-1"
                                >
                                    HIPERTROFIA
                                </span>
                            </div>
                        </div>

                        <!-- Miniatura 3 -->
                        <div
                            class="group relative aspect-4/3 rounded-lg overflow-hidden border border-primary/40 transition-all cursor-pointer shadow-xl bg-basic-900"
                        >
                            <img
                                src="/img/foto4.webp"
                                alt="Acondicionamiento físico"
                                loading="lazy"
                                class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-110"
                            />
                            <div
                                class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-colors flex items-center justify-center"
                            >
                                <span
                                    class="block text-[11px] sm:text-xs text-basic-50 uppercase tracking-widest font-bold mb-1"
                                >
                                    DEFINICIÓN
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    @keyframes pulse-frame-top {
        0%,
        100% {
            opacity: 1;
            filter: drop-shadow(0 0 16px rgba(68, 255, 51, 0.85));
        }
        50% {
            opacity: 0.15;
            filter: drop-shadow(0 0 0px transparent);
        }
    }

    @keyframes pulse-frame-bottom {
        0%,
        100% {
            opacity: 0.15;
            filter: drop-shadow(0 0 0px transparent);
        }
        50% {
            opacity: 1;
            filter: drop-shadow(0 0 14px rgba(68, 255, 51, 0.85));
        }
    }

    .animate-pulse-top {
        animation: pulse-frame-top 2.6s ease-in-out infinite;
    }

    .animate-pulse-bottom {
        animation: pulse-frame-bottom 2.6s ease-in-out infinite;
    }
</style>
