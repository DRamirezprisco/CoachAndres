---
import AmbientGlow from "@/components/AmbientGlow.astro";
import TranslucentText from "@/components/TranslucentText.astro";
import ItemsTestimonios from "@/components/testimonios/ItemsTestimonios.astro";
---

<section
    id="testimonios"
    class="relative overflow-hidden bg-basic min-h-[125vh] sm:min-h-[135vh] lg:min-h-[145vh] py-40 sm:py-56 lg:py-68 flex items-center justify-center"
>
    <!-- Fondo y efectos de iluminación -->
    <AmbientGlow />

    <!-- Resplandor de alta intensidad -->
    <div
        class="absolute top-1/3 right-1/4 w-87.5 sm:w-130 h-87.5 sm:h-130 bg-primary/15 rounded-full blur-[140px] pointer-events-none -z-10"
    >
    </div>

    <!-- Imagen del gimnasio de fondo, opaca y centrada (Capa z-0) -->
    <div
        class="absolute inset-x-0 top-36 sm:top-52 lg:top-64 bottom-36 sm:bottom-52 lg:bottom-64 flex items-center justify-center pointer-events-none z-0 overflow-hidden"
    >
        <img
            src="/img/intento9.webp"
            alt="Fondo del gimnasio"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover object-center opacity-15 sm:opacity-20 filter contrast-125"
        />
        <!-- Degradados para fundir suavemente los bordes superior e inferior con el fondo basic (#1C1C1C) -->
        <div
            class="absolute inset-x-0 top-0 h-36 sm:h-44 bg-linear-to-b from-basic via-basic/80 to-transparent"
        >
        </div>
        <div
            class="absolute inset-x-0 bottom-0 h-36 sm:h-44 bg-linear-to-t from-basic via-basic/80 to-transparent"
        >
        </div>
        <div
            class="absolute inset-y-0 left-0 w-32 bg-linear-to-r from-basic to-transparent"
        >
        </div>
        <div
            class="absolute inset-y-0 right-0 w-32 bg-linear-to-l from-basic to-transparent"
        >
        </div>
    </div>

    <!-- Textos gigantes de fondo (Capa z-2, por encima de la imagen del gym y con mayor notoriedad) -->
    <TranslucentText
        text="FISICO"
        verticalPosition="top-10 sm:top-14 lg:top-18"
        opacity="opacity-15 sm:opacity-20"
        zIndex="z-2"
    />

    <TranslucentText
        text="PERFECTO"
        align="right"
        verticalPosition="bottom-10 sm:bottom-14 lg:bottom-18"
        opacity="opacity-15 sm:opacity-20"
        zIndex="z-2"
    />

    <!-- Contenido Principal -->
    <div
        class="relative z-10 mx-auto max-w-7xl px-6 w-full flex justify-center"
    >
        <ItemsTestimonios />
    </div>
</section>
